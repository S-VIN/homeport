# Required: two distinct DNS names under the same parent domain, pointing to the VDS.
HOMEPORT_PANEL_DOMAIN=panel.example.com
HOMEPORT_AUTH_DOMAIN=auth.example.com

# VLESS on TCP 443 for a new installation; empty means the panel's domain.
# Later changes are made in the panel.
VLESS_DOMAIN=

# Required: absolute path on the VDS. Docker creates service subdirectories here.
DATA_DIR=/srv/homeport

# Required: ordinary login/password. Tinyauth generates bcrypt automatically.
# Single quotes preserve literal $ and spaces. Escape a single quote as \'.
TINYAUTH_USERNAME=admin
TINYAUTH_PASSWORD=''

# Public Caddy listeners. Keep 443 free if it will serve VLESS/REALITY.
HTTPS_PORT=8443
# ACME HTTP-01 always connects to public TCP 80. A different HTTP_PORT needs forwarding from 80.
HTTP_PORT=80
CADDY_BIND=0.0.0.0
# Optional certificate contact email.
ACME_EMAIL=

# Internal management listeners stay on 127.0.0.1; these ports must be distinct and unused.
HOMEPORT_UI_PORT=20800
TINYAUTH_PORT=20801
# Recheck authorization when a long-lived WebSocket reconnects.
WS_MAX_DURATION=1h

# Images can be pinned to a version or digest.
HOMEPORT_IMAGE=ghcr.io/s-vin/homeport:latest
TINYAUTH_IMAGE=ghcr.io/tinyauthapp/tinyauth:v5
CADDY_IMAGE=caddy:2-alpine

TZ=UTC
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
