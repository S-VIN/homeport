# Only what `cargo build --bin homeport`, scripts/build.py, mihomo.py and presets/server.sql need.
.git
.agents
.claude
.codex
.cursor
.vscode
.idea
.cache
.venv
node_modules
.github
target
dist
**/__pycache__
**/.env
**/.env.*
**/*.sqlite3*
web/pkg

# The install-to-server plugin embeds these templates at compile time.
/docker/*
!/docker/compose.yaml
!/docker/Caddyfile
/.dockerignore
/*.md
/scripts/package.py
/scripts/packaging/
/scripts/test-docker-auth.py
# Tests are not built into the image; editing them must not invalidate the build layer.
/tests/
/crates/*/tests/
/plugins/*/tests/

# Docker images only use the two Linux cores.
/assets/mihomo/win32/
/assets/mihomo/darwin/
/assets/mihomo/**/*.download
